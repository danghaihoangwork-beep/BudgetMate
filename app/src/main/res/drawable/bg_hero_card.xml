<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="225"
                android:startColor="@color/bm_surface"
                android:endColor="@color/bm_surface_3"
                android:type="linear" />
            <stroke android:width="1dp" android:color="@color/bm_hairline" />
        </shape>
    </item>

    <item
        android:top="-80dp"
        android:right="-60dp"
        android:left="120dp"
        android:bottom="40dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="120dp"
                android:startColor="@color/bm_gold_glow"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>

    <item android:bottom="-1dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/bm_white_inner_highlight" />
        </shape>
    </item>
</layer-list>