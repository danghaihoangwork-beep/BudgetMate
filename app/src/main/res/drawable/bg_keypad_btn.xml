<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/bm_gold_press">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="12dp" />
                            <solid android:color="@color/bm_surface_2" />
                            <stroke android:width="1dp" android:color="@color/bm_gold_hairline" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item>
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="12dp" />
                            <solid android:color="@color/bm_surface" />
                            <stroke android:width="1dp" android:color="@color/bm_hairline" />
                        </shape>
                    </item>
                    <item android:bottom="-1dp">
                        <shape android:shape="rectangle">
                            <corners android:radius="12dp" />
                            <solid android:color="@android:color/transparent" />
                            <stroke android:width="1dp" android:color="@color/bm_white_inner_highlight" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>