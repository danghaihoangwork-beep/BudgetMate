<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ════════════════════════════════════════
         LAYER 1 · Base radial gradient
         Slight lift in the upper-center, deep navy at the corners.
         Gives the icon a "domed" feeling like a polished card.
         ════════════════════════════════════════ -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="42"
                android:gradientRadius="82">
                <item android:offset="0.00" android:color="#FF1B2547" />
                <item android:offset="0.45" android:color="#FF111A38" />
                <item android:offset="0.80" android:color="#FF0A1128" />
                <item android:offset="1.00" android:color="#FF04081A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- ════════════════════════════════════════
         LAYER 2 · Premium gold light source
         A warm gold radial bleed in the top-right corner —
         simulates a luxe key-light hitting a metal surface.
         ════════════════════════════════════════ -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="94"
                android:centerY="14"
                android:gradientRadius="62">
                <item android:offset="0.00" android:color="#55D4AF37" />
                <item android:offset="0.45" android:color="#1ED4AF37" />
                <item android:offset="0.85" android:color="#06D4AF37" />
                <item android:offset="1.00" android:color="#00D4AF37" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- ════════════════════════════════════════
         LAYER 3 · Cool teal counter-glow
         Subtle teal bloom in the bottom-left — completes the
         complementary fintech palette (gold ⟷ teal).
         ════════════════════════════════════════ -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="10"
                android:centerY="100"
                android:gradientRadius="52">
                <item android:offset="0.00" android:color="#3014B8A6" />
                <item android:offset="0.60" android:color="#0814B8A6" />
                <item android:offset="1.00" android:color="#0014B8A6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- ════════════════════════════════════════
         LAYER 4 · Geometric mesh — vertical
         Thin gold-tinted grid lines (4% alpha) — the
         "engraved metal card" texture.
         ════════════════════════════════════════ -->
    <path
        android:pathData="M18,0 L18,108 M36,0 L36,108 M54,0 L54,108 M72,0 L72,108 M90,0 L90,108"
        android:strokeColor="#0CD4AF37"
        android:strokeWidth="0.4" />

    <!-- ════════════════════════════════════════
         LAYER 5 · Geometric mesh — horizontal
         ════════════════════════════════════════ -->
    <path
        android:pathData="M0,18 L108,18 M0,36 L108,36 M0,54 L108,54 M0,72 L108,72 M0,90 L108,90"
        android:strokeColor="#0CD4AF37"
        android:strokeWidth="0.4" />

    <!-- ════════════════════════════════════════
         LAYER 6 · Diagonal hairlines
         Two long 45° lines for a brushed-metal hint
         (white at 3% alpha — barely there but reads in light).
         ════════════════════════════════════════ -->
    <path
        android:pathData="M-30,118 L138,-30 M-30,140 L140,-20"
        android:strokeColor="#10FFFFFF"
        android:strokeWidth="0.5" />

    <!-- ════════════════════════════════════════
         LAYER 7 · Counter-diagonal hairlines
         The cross-weave that finishes the mesh feel.
         ════════════════════════════════════════ -->
    <path
        android:pathData="M-30,-12 L130,148 M-30,-30 L140,140"
        android:strokeColor="#0CFFFFFF"
        android:strokeWidth="0.5" />

    <!-- ════════════════════════════════════════
         LAYER 8 · Inner glow plate
         A very faint elliptical lift centered just above
         middle — preps the eye for where the coin will sit.
         ════════════════════════════════════════ -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="52"
                android:gradientRadius="38">
                <item android:offset="0.00" android:color="#22D4AF37" />
                <item android:offset="0.65" android:color="#06D4AF37" />
                <item android:offset="1.00" android:color="#00D4AF37" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- ════════════════════════════════════════
         LAYER 9 · Vignette
         Dark falloff in the corners — pushes the eye to
         center, sells the "embossed card" depth.
         ════════════════════════════════════════ -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="78">
                <item android:offset="0.50" android:color="#00000000" />
                <item android:offset="0.85" android:color="#40000000" />
                <item android:offset="1.00" android:color="#A0000000" />
            </gradient>
        </aapt:attr>
    </path>
</vector>