<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bm_bg"
    android:paddingHorizontal="20dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log an entry"
                android:textColor="@color/bm_text"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="-0.025"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_theme"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_day"
            android:background="@drawable/bg_chip_idle"
            app:tint="@color/bm_muted"
            android:layout_marginEnd="8dp"
            android:contentDescription="Toggle theme" />

        <ImageView
            android:id="@+id/btn_notifications"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="10dp"
            android:src="@android:drawable/ic_popup_reminder"
            android:background="@drawable/bg_chip_idle"
            app:tint="@color/bm_muted"
            android:contentDescription="Notifications" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_hero_card"
        android:padding="16dp"
        android:layout_marginTop="14dp"
        android:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THIS MONTH · NET"
                    android:textColor="@color/bm_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14" />

                <TextView
                    android:id="@+id/tv_total_balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textColor="@color/bm_gold"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:letterSpacing="-0.02"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tv_delta_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ 0.0%"
                    android:textColor="@color/bm_income"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_income_change_pill"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="vs Last Month"
                    android:textColor="@color/bm_muted_2"
                    android:textSize="10sp"
                    android:letterSpacing="0.03"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bm_hairline_2"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/divider_dot"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INCOME"
                        android:textColor="@color/bm_muted"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_total_income"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textColor="@color/bm_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/bm_hairline_2" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/divider_dot_expense"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EXPENSES"
                        android:textColor="@color/bm_muted"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_total_expenses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textColor="@color/bm_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:layout_marginTop="3dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_segment_track"
        android:padding="4dp"
        android:layout_marginTop="14dp">

        <TextView
            android:id="@+id/tab_expenses"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EXPENSE"
            android:textColor="@color/bm_ink"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:background="@drawable/bg_segment_active_expense"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tab_income"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="INCOME"
            android:textColor="@color/bm_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:background="@drawable/bg_segment_inactive"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginTop="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_spending_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPENDING"
                android:textColor="@color/bm_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />

            <TextView
                android:id="@+id/tv_amount_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="−$0"
                android:textColor="@color/bm_text"
                android:textSize="44sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="-0.025"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_date_picker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_date_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@android:drawable/ic_menu_my_calendar"
                app:tint="@color/bm_gold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tv_selected_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tue, May 19"
                android:textColor="@color/bm_text_dim"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="14dp"
        android:paddingVertical="2dp"
        android:layout_marginTop="14dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/bm_muted_2"
            android:layout_marginEnd="10dp" />

        <EditText
            android:id="@+id/et_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Lunch at Banh Mi 25"
            android:textColorHint="@color/bm_muted_3"
            android:textColor="@color/bm_text"
            android:textSize="13sp"
            android:background="@null"
            android:inputType="text"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CATEGORY"
            android:textColor="@color/bm_gold"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />

        <TextView
            android:id="@+id/tv_see_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="See all →"
            android:textColor="@color/bm_muted_2"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/layout_categories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍜  Food"
                android:textColor="@color/bm_ink"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_active"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚗  Transport"
                android:textColor="@color/bm_text_dim"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_idle"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠  Housing"
                android:textColor="@color/bm_text_dim"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_idle"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💊  Health"
                android:textColor="@color/bm_text_dim"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_idle"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛍️  Shopping"
                android:textColor="@color/bm_text_dim"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_idle"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧾  Bills"
                android:textColor="@color/bm_text_dim"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_idle"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <GridLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:columnCount="3"
            android:rowCount="4"
            android:layout_marginEnd="8dp">

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_1" android:text="1" style="@style/BMKeypadDigit" android:backgroundTint="@null" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_2" android:text="2" style="@style/BMKeypadDigit" android:backgroundTint="@null" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_3" android:text="3" style="@style/BMKeypadDigit" android:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_4" android:text="4" style="@style/BMKeypadDigit" android:backgroundTint="@null" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_5" android:text="5" style="@style/BMKeypadDigit" android:backgroundTint="@null" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_6" android:text="6" style="@style/BMKeypadDigit" android:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_7" android:text="7" style="@style/BMKeypadDigit" android:backgroundTint="@null" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_8" android:text="8" style="@style/BMKeypadDigit" android:backgroundTint="@null" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_9" android:text="9" style="@style/BMKeypadDigit" android:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_dot" android:text="." style="@style/BMKeypadDigit" android:backgroundTint="@null" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_0" android:text="0" style="@style/BMKeypadDigit" android:backgroundTint="@null" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_clear" android:text="⌫" style="@style/BMKeypadDigit" android:backgroundTint="@null" />
        </GridLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:text="✓\nSAVE"
            android:textColor="@color/bm_ink"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:fontFamily="sans-serif-black"
            android:lineSpacingExtra="4dp"
            android:background="@drawable/bg_save_btn"
            android:backgroundTint="@null"
            android:padding="8dp"
            android:elevation="0dp" />
    </LinearLayout>

</LinearLayout>