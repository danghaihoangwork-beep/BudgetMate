<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_transaction_card"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_tile">
        <TextView
            android:id="@+id/tv_trans_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="🍜"
            android:textSize="18sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tv_trans_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Transaction Title"
            android:textColor="@color/bm_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">
            <TextView
                android:id="@+id/tv_trans_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="General"
                android:textColor="@color/bm_gold"
                android:textSize="11sp"
                android:textStyle="bold" />
            <View
                android:layout_width="3dp"
                android:layout_height="3dp"
                android:background="@drawable/bg_meta_dot"
                android:layout_marginHorizontal="6dp" />
            <TextView
                android:id="@+id/tv_trans_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00 PM"
                android:textColor="@color/bm_muted_2"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_trans_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/bm_muted_3"
            android:textSize="11sp"
            android:textStyle="italic"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"
            tools:text="Optional transaction internal note"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_trans_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$0.00"
        android:textColor="@color/bm_text"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:gravity="end" />

</LinearLayout>