<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bm_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MARKET TRACKER"
            android:textColor="@color/bm_muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terminal"
            android:textColor="@color/bm_text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="-0.025"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout_market"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/bm_bg"
        app:tabBackground="@color/bm_bg"
        app:tabIndicatorColor="@color/bm_gold"
        app:tabIndicatorHeight="2dp"
        app:tabSelectedTextColor="@color/bm_text"
        app:tabTextColor="@color/bm_muted"
        app:tabTextAppearance="@android:style/TextAppearance.Widget.TextView"
        android:paddingHorizontal="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bm_hairline" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_market"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never" />

</LinearLayout>