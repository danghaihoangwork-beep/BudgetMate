<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#111827"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="12dp">

    <TextView android:id="@+id/tv_vn_index"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:gravity="center"
        android:textColor="#34D399" android:textSize="12sp"
        android:lineSpacingMultiplier="1.3"/>

    <View android:layout_width="1dp" android:layout_height="match_parent"
        android:background="#1A233D"/>

    <TextView android:id="@+id/tv_hnx"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:gravity="center"
        android:textColor="#34D399" android:textSize="12sp"
        android:lineSpacingMultiplier="1.3"/>

    <View android:layout_width="1dp" android:layout_height="match_parent"
        android:background="#1A233D"/>

    <TextView android:id="@+id/tv_upcom"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:gravity="center"
        android:textColor="#F87171" android:textSize="12sp"
        android:lineSpacingMultiplier="1.3"/>
</LinearLayout>